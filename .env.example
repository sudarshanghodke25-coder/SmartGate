# =============================================================================
# SmartGate Environment Variables
# =============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# =============================================================================

# Supabase project URL (public, safe for frontend)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase anon/public key (public, safe for frontend — NOT the service-role key)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# =============================================================================
# SECURITY WARNING
# =============================================================================
# The Supabase service-role key must NEVER be placed here or in any frontend
# code. It belongs only in server-side environment variables (e.g., Supabase
# Edge Function secrets or deployment platform environment configuration).
# =============================================================================
